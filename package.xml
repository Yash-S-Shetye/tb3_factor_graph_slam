<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>tb3_factor_graph_slam</name>
  <version>0.1.0</version>
  <description>
    2D pose graph SLAM for TurtleBot3 using ICP scan matching for odometry
    edges, radius-based loop closure detection, and GTSAM Pose2 factor
    graph optimization.
  </description>
  <maintainer email="you@example.com">Yash</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>libpcl-all-dev</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>